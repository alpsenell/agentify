# Production origin used for canonical/OG URLs, sitemap.xml and robots.txt
PUBLIC_SITE_URL=https://agentify.plus

# --- The app (/dashboard) and its API ---

# Claude credentials. Without this the app loads but the agents cannot run.
ANTHROPIC_API_KEY=
# Optional: the model every agent uses (default claude-opus-5-5).
# AGENTIFY_MODEL=claude-opus-5-5

# Signs session cookies and encrypts stored Shopify tokens. Required in
# production, 16+ random characters (e.g. `openssl rand -base64 32`).
# Changing it signs everyone out and makes saved store tokens unreadable.
SESSION_SECRET=

# Database: Redis over REST (Upstash, or the Vercel KV / Upstash integration,
# which sets these for you). Required on Vercel. Left empty locally, data is
# kept as JSON files under .data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local development only: run the pipeline with a scripted stand-in for the
# model, to work on the UI without credentials. Never set in production.
# AGENTIFY_FAKE_LLM=1

# --- Optional integrations: each switches on when its variables are set ---

# Shopify app (one-click "Connect with Shopify"). Create an app in the Shopify
# Dev Dashboard; set its redirect URL to <origin>/api/shopify/oauth/callback.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=read_themes,write_themes,read_products
# SHOPIFY_REDIRECT_URI=https://agentify.plus/api/shopify/oauth/callback

# GitHub App (theme repositories and pull requests). Permissions: Contents
# read/write, Pull requests read/write, Metadata read. Callback URL
# <origin>/api/github/callback, with "Request user authorization (OAuth)
# during installation" on.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The PEM private key; literal \n line breaks are accepted.
GITHUB_APP_PRIVATE_KEY=

# Stripe (plans). Webhook endpoint: <origin>/api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PILOT=
STRIPE_PRICE_TEAM=

# Email through Resend (invitations and "a request needs you").
RESEND_API_KEY=
EMAIL_FROM=
