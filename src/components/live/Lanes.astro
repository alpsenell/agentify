---
import { LANES, IN_FLIGHT, ON_SHIFT, AGENT_STATUS_COLOR, isStalled } from '../../data/live';
const last = LANES.length - 1;
---
<section class="lanes container" aria-labelledby="lanes-heading">
  <div class="strip mono">
    <span class="k">orchestration</span>
    <h2 id="lanes-heading" class="h">five lanes, running at once</h2>
    <span class="rule" aria-hidden="true"></span>
    <p class="k">{IN_FLIGHT} tickets in flight · {ON_SHIFT} agents on shift</p>
  </div>

  <div class="board">
    <div class="scroller">
      <ol class="grid">
        {LANES.map((l, li) => {
          const gate = li === last;
          const first = li === 0;
          const blocked = l.agents.some(isStalled);
          return (
            <li class:list={['lane', { 'lane--first': first, 'lane--gate': gate, 'lane--blocked': blocked }]}>
              <header class="lane-head">
                <div class="row">
                  <span class="num mono">{l.num}</span>
                  <h3 class="name mono">{l.name}</h3>
                </div>
                <div class="row wip-row">
                  <span class="wip">{l.wip}</span>
                  <span class="mute mono">in lane</span>
                  <span class="mute mono mode">{l.mode}</span>
                </div>
              </header>

              <div class="pipe" aria-hidden="true"></div>

              <div class="body">
                <ul class="agents">
                  {l.agents.map((a) => {
                    const stalled = isStalled(a);
                    return (
                      <li
                        class:list={['agent', { 'is-stalled': stalled, 'is-hot': !stalled && a.load > 0.8, 'is-idle': !stalled && a.load < 0.25 }]}
                        data-agent={a.name}
                        data-stalled={stalled ? 'true' : 'false'}
                        data-load={a.load}
                        style={`--load:${a.load}`}
                      >
                        <div class="agent-row">
                          <h4 class="agent-name">{a.name}</h4>
                          <span class="status mono" style={`color:${AGENT_STATUS_COLOR[a.status]}`}>{a.status}</span>
                        </div>
                        <p class="task">{a.task}</p>
                        <div class="load-row">
                          <div class="track" role="progressbar" aria-label={`${a.name} load`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(a.load * 100)} data-load-bar>
                            <div class="fill"></div>
                          </div>
                          <span class="pct mono" data-load-pct>{Math.round(a.load * 100)}%</span>
                        </div>
                        <div class="meta mono">
                          <span>{a.tickets} open</span>
                          <span class="right">{a.throughput}</span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
                <p class="note mono">{l.note}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>

    <ul class="legend mono" aria-label="Legend">
      <li><span class="sw" style="background:var(--mag)" aria-hidden="true"></span>working in parallel</li>
      <li><span class="sw" style="background:var(--orange)" aria-hidden="true"></span>blocked or at a gate</li>
      <li><span class="sw" style="background:var(--idle)" aria-hidden="true"></span>idle capacity</li>
      <li class="right">lanes are independent — a block in one does not stall the others</li>
    </ul>
  </div>
</section>

<style>
  .lanes { position: relative; z-index: 1; padding-top: 30px; }
  .strip {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    font-size: 10px; letter-spacing: 0.2em; margin-bottom: 18px;
  }
  .strip .h { font: inherit; letter-spacing: inherit; text-transform: inherit; }
  .k { color: var(--mute); }
  .rule { flex: 1; height: 1px; background: var(--line); min-width: 40px; }

  .board { border: 1px solid var(--ink); background: var(--card); }
  .scroller { overflow-x: auto; }
  .grid { display: grid; grid-template-columns: repeat(5, minmax(228px, 1fr)); min-width: max-content; }
  @media (min-width: 1180px) { .grid { min-width: 0; } }

  .lane { display: flex; flex-direction: column; border-right: 1px solid var(--ink); }
  .lane:last-child { border-right: 0; }

  .lane-head { padding: 12px 14px; border-bottom: 1px solid var(--ink); color: var(--ink); --mute-h: var(--mute); }
  .lane--first .lane-head { background: var(--ink); color: var(--card); --mute-h: var(--dark-mute); }
  .lane--gate .lane-head { background: var(--orange-deep); color: var(--card); --mute-h: #ffd0c7; }
  .row { display: flex; align-items: baseline; gap: 8px; }
  .wip-row { margin-top: 8px; }
  .num { font-size: 9px; color: var(--mute-h); }
  .name { font-size: 10px; letter-spacing: 0.14em; font-weight: 400; }
  .wip { font-size: 22px; font-weight: 700; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .mute { font-size: 9px; letter-spacing: 0.14em; color: var(--mute-h); }
  .mode { margin-left: auto; }

  .pipe {
    height: 4px; background: #fce3d6;
    background-image: repeating-linear-gradient(90deg, var(--mag) 0 6px, transparent 6px 24px);
    background-size: 24px 4px;
    animation: ag-slide 1.1s linear infinite;
  }
  .lane--blocked .pipe {
    background-color: #ffe4dd;
    background-image: repeating-linear-gradient(90deg, var(--orange) 0 6px, transparent 6px 24px);
  }

  .body { padding: 12px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .agents { display: flex; flex-direction: column; gap: 10px; }

  .agent {
    border: 1px solid var(--ink); border-left: 3px solid var(--idle);
    background: var(--paper); padding: 11px 12px;
    --bar: var(--mag);
  }
  .agent.is-hot { border-left-color: var(--mag); }
  .agent.is-idle { --bar: var(--idle); }
  .agent.is-stalled { border-color: var(--orange); border-left-color: var(--orange); background: #fff3f0; --bar: var(--orange); }

  .agent-row { display: flex; align-items: baseline; gap: 8px; margin-bottom: 7px; }
  .agent-name { font-size: 16px; font-weight: 700; letter-spacing: -0.025em; }
  .status { margin-left: auto; font-size: 9px; letter-spacing: 0.14em; }
  .task { font-size: 12px; line-height: 1.45; color: var(--body); min-height: 34px; }

  .load-row { display: flex; align-items: center; gap: 9px; margin-top: 9px; }
  .track { flex: 1; height: 6px; background: var(--track); position: relative; }
  .fill { position: absolute; inset: 0 auto 0 0; width: calc(var(--load) * 100%); background: var(--bar); transition: width .7s ease, background-color .3s ease; }
  .pct { font-size: 9px; color: var(--mute); font-variant-numeric: tabular-nums; min-width: 34px; text-align: right; letter-spacing: 0; text-transform: none; }

  .meta { display: flex; align-items: baseline; gap: 8px; margin-top: 7px; font-size: 9px; letter-spacing: 0.12em; color: var(--mute); }
  .right { margin-left: auto; }

  .note { margin-top: auto; padding-top: 8px; border-top: 1px solid var(--line); font-size: 9px; line-height: 1.5; letter-spacing: 0.1em; color: var(--mute); }

  .legend {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
    padding: 12px 16px; border-top: 1px solid var(--ink);
    font-size: 9px; letter-spacing: 0.14em; color: var(--mute);
  }
  .legend li { display: flex; align-items: center; gap: 7px; }
  .sw { width: 8px; height: 8px; }
</style>
