---
import { TIERS } from '../../data/console';
---
<section id="access" class="access container" aria-labelledby="access-heading">
  <div class="strip mono">
    <span class="k">04</span>
    <h2 id="access-heading" class="h">access</h2>
    <span class="rule" aria-hidden="true"></span>
  </div>

  <ul class="tiers">
    {TIERS.map((t) => (
      <li class:list={['tier', { 'tier--featured': t.featured }]}>
        <p class="head mono">
          <span class="kicker">{t.kicker}</span>
          <span class="slots">{t.slots}</span>
        </p>
        <h3 class="price">{t.price}</h3>
        <p class="unit mono">{t.unit}</p>
        <ul class="features">
          {t.features.map((f) => (
            <li><span class="tick" aria-hidden="true">—</span><span>{f}</span></li>
          ))}
        </ul>
        <a class="cta mono" href="/contact">{t.cta}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .access { position: relative; z-index: 1; padding-block: 20px 60px; }
  .strip { display: flex; align-items: baseline; gap: 14px; font-size: 10px; letter-spacing: 0.2em; margin-bottom: 24px; }
  .strip .h { font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink); }
  .k { color: var(--mute); }
  .rule { flex: 1; height: 1px; background: var(--line); min-width: 30px; }

  .tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-left: 1px solid var(--ink); border-top: 1px solid var(--ink); }
  .tier {
    border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
    padding: 26px; display: flex; flex-direction: column;
    --kicker: var(--mute); --tick: var(--mute);
  }
  .tier--featured {
    background: var(--ink); color: var(--paper);
    --kicker: var(--mag-light); --tick: var(--mag-light);
  }

  .head { display: flex; align-items: baseline; gap: 10px; font-size: 9px; letter-spacing: 0.18em; }
  .kicker { color: var(--kicker); }
  .slots { margin-left: auto; color: var(--mute); }
  .tier--featured .slots { color: var(--dark-mute); }

  .price { font-size: clamp(30px, 3vw, 40px); font-weight: 800; letter-spacing: -0.04em; margin: 20px 0 2px; font-variant-numeric: tabular-nums; }
  .unit { font-size: 9px; letter-spacing: 0.14em; color: var(--mute); margin-bottom: 24px; }
  .tier--featured .unit { color: var(--dark-mute); }

  .features { display: flex; flex-direction: column; gap: 9px; margin-bottom: 26px; }
  .features li { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 10px; font-size: 14px; line-height: 1.5; }
  .tick { color: var(--tick); }

  .cta {
    margin-top: auto; text-align: center; background: transparent; color: var(--ink);
    border: 1px solid var(--ink); padding: 12px 16px; font-size: 10px; letter-spacing: 0.16em;
  }
  .cta:hover { opacity: 0.85; color: var(--ink); }
  .tier--featured .cta { background: var(--mag); color: var(--card); border-color: var(--mag); }
  .tier--featured .cta:hover { color: var(--card); }

  @media (max-width: 860px) { .tiers { grid-template-columns: minmax(0, 1fr); } }
</style>
