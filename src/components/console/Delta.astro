---
import { COMPARE } from '../../data/console';
---
<section id="delta" class="delta container" aria-labelledby="delta-heading">
  <div class="strip mono">
    <span class="k">03</span>
    <h2 id="delta-heading" class="h">the delta</h2>
    <span class="rule" aria-hidden="true"></span>
  </div>

  <div class="scroller">
    <table class="compare">
      <caption class="visually-hidden">Agentify compared with a retainer agency</caption>
      <thead>
        <tr>
          <th scope="col" class="mono">metric</th>
          <th scope="col" class="mono">retainer agency</th>
          <th scope="col" class="mono th--us">agentify</th>
        </tr>
      </thead>
      <tbody>
        {COMPARE.map((c) => (
          <tr>
            <th scope="row">{c.label}</th>
            <td class="them">{c.them}</td>
            <td class="us">{c.us}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .delta { position: relative; z-index: 1; padding-block: 20px 60px; max-width: 1180px; }
  .strip { display: flex; align-items: baseline; gap: 14px; font-size: 10px; letter-spacing: 0.2em; margin-bottom: 24px; }
  .strip .h { font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink); }
  .k { color: var(--mute); }
  .rule { flex: 1; height: 1px; background: var(--line); min-width: 30px; }

  .scroller { overflow-x: auto; }
  .compare { width: 100%; min-width: 520px; border-collapse: collapse; text-align: left; border-top: 1px solid var(--ink); }
  thead th {
    padding: 11px 16px; font-size: 9px; letter-spacing: 0.18em; color: var(--mute); font-weight: 400;
  }
  thead th:first-child { padding-left: 0; width: 34%; }
  thead .th--us { color: var(--card); background: var(--mag); }

  tbody th, tbody td { border-top: 1px solid var(--line); font-size: 14px; padding: 15px 16px; }
  tbody th { padding-left: 0; font-weight: 400; }
  .them { color: var(--mute); }
  .us { font-weight: 600; background: #fdf1ea; }
</style>
