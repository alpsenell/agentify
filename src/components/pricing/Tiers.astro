---
import { TIERS } from '../../data/pricing';
---
<section class="tiers container" aria-labelledby="tiers-heading">
  <h2 id="tiers-heading" class="visually-hidden">Plans</h2>
  <ul class="tier-grid">
    {TIERS.map((t) => (
      <li class:list={['tier', { featured: t.featured }]}>
        <div class="row mono">
          <h3 class="kicker">{t.kicker}</h3>
          <span class="slots">{t.slots}</span>
        </div>
        <p class="price">{t.price}</p>
        <p class="unit mono">{t.unit}</p>
        <p class="pitch">{t.pitch}</p>
        <ul class="features">
          {t.features.map((f) => (
            <li class="feature"><span class="tick" aria-hidden="true">—</span><span>{f}</span></li>
          ))}
        </ul>
        <a class="cta mono" href="/contact">{t.cta}<span class="visually-hidden"> — {t.kicker}</span></a>
      </li>
    ))}
  </ul>
</section>

<style>
  .tiers { position: relative; z-index: 1; padding-block: 30px 0; }
  .tier-grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border-left: 1px solid var(--ink); border-top: 1px solid var(--ink);
  }
  .tier {
    border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
    padding: 28px; display: flex; flex-direction: column;
    background: transparent; color: var(--ink);
  }
  .tier.featured { background: var(--ink); color: var(--paper); }

  .row { display: flex; align-items: center; font-size: 9px; letter-spacing: 0.18em; }
  .kicker { color: var(--mute); font-size: inherit; font-weight: inherit; letter-spacing: inherit; }
  .slots { margin-left: auto; color: var(--mute); }
  .featured .kicker { color: var(--mag-light); }
  .featured .slots { color: var(--dark-mute); }

  .price {
    font-size: 46px; font-weight: 800; letter-spacing: -0.045em;
    margin: 22px 0 2px; font-variant-numeric: tabular-nums; line-height: 1.05;
  }
  .unit { font-size: 9px; letter-spacing: 0.14em; color: var(--mute); margin-bottom: 20px; }
  .featured .unit { color: var(--dark-mute); }

  .pitch { font-size: 14px; line-height: 1.55; color: var(--body); margin: 0 0 22px; }
  .featured .pitch { color: var(--dark-mute); }

  .features { display: flex; flex-direction: column; gap: 9px; margin-bottom: 26px; }
  .feature { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 10px; font-size: 14px; line-height: 1.5; }
  .tick { color: var(--mute); }
  .featured .tick { color: var(--mag-light); }

  .cta {
    margin-top: auto; text-align: center;
    background: transparent; color: var(--ink); border: 1px solid var(--ink);
    padding: 13px 16px; font-size: 10px; letter-spacing: 0.16em;
  }
  .cta:hover { opacity: 0.85; color: var(--ink); }
  .featured .cta { background: var(--mag); color: var(--card); border-color: var(--mag); }
  .featured .cta:hover { opacity: 0.85; color: var(--card); }

  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
