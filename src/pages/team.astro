---
import Base from '../layouts/Base.astro';
import Hero from '../components/team/Hero.astro';
import StageFilter from '../components/team/StageFilter.astro';
import Roster from '../components/team/Roster.astro';
import Handoff from '../components/team/Handoff.astro';
import Cta from '../components/team/Cta.astro';
import { TEAM, slug } from '../data/team';

const title = 'The team: ten agents, ten standing briefs';
const description =
  'Ten roles with a written brief, allowed inputs, expected outputs and a hard stop — the Shopify build agents Agentify runs behind your approval gate.';
const origin = (Astro.site ?? new URL('https://agentify.plus')).origin;

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Console', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Team', item: `${origin}/team` },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'The Agentify build team',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: TEAM.length,
    itemListElement: TEAM.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${origin}/team#agent-${slug(m)}`,
      item: {
        '@type': 'Thing',
        name: `${m.name} — ${m.role}`,
        description: m.brief,
        url: `${origin}/team#agent-${slug(m)}`,
      },
    })),
  },
];
---
<Base
  title={title}
  description={description}
  path="/team"
  ogImage="/og/team.png"
  ogImageAlt="The Agentify team: ten agent roles from intake to the human gate, each with a brief and a hard stop"
  jsonLd={jsonLd}
  footerNote="agentify · a shopify build team that runs itself"
>
  <Hero />
  <StageFilter />
  <Roster />
  <Handoff />
  <Cta />
</Base>

<script src="../scripts/team.ts"></script>
