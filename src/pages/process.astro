---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PageCta from '../components/PageCta.astro';
import Stages from '../components/process/Stages.astro';
import Walkthrough from '../components/process/Walkthrough.astro';
import Gates from '../components/process/Gates.astro';
import { STAGES } from '../data/process';

const title = 'Process: seven stages, three gates';
const description =
  'How every Agentify change to your Shopify store walks the same seven stages, from intake to ship, and the three gates that can send a ticket backwards.';
const origin = (Astro.site ?? new URL('https://agentify.plus')).origin;

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Console', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Process', item: `${origin}/process` },
    ],
  },
  {
    '@type': 'HowTo',
    name: 'How a ticket moves through the Agentify pipeline',
    description,
    step: STAGES.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.body,
    })),
  },
];
---
<Base
  title={title}
  description={description}
  path="/process"
  ogImage="/og/process.png"
  ogImageAlt="The Agentify pipeline: seven stages from intake to ship with three gates"
  jsonLd={jsonLd}
  footerNote="agentify · a shopify build team that runs itself"
>
  <PageHero eyebrow="process · seven stages, three gates" title="A ticket cannot skip a stage.">
    The pipeline is the product. Every change to your store walks the same seven stages in the same order, and three of those stages can send it backwards. Click a stage to see what enters, what leaves, and what stops it.
  </PageHero>

  <Stages />
  <Walkthrough />
  <Gates />

  <PageCta
    title="Watch it happen on a live board."
    body="The Live page shows the same pipeline running on real tickets — queue depth, agent load, and what shipped in the last hour."
    secondary={{ href: '/live', label: 'Open live board' }}
    primary={{ href: '/contact', label: 'Open a pilot' }}
  />
</Base>

<script src="../scripts/process.ts"></script>
