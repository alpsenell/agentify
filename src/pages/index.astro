---
import Base from '../layouts/Base.astro';
import Hero from '../components/console/Hero.astro';
import ConsoleSection from '../components/console/ConsoleSection.astro';
import Band from '../components/console/Band.astro';
import Team from '../components/console/Team.astro';
import Delta from '../components/console/Delta.astro';
import Access from '../components/console/Access.astro';
import Faqs from '../components/console/Faqs.astro';
import Contact from '../components/console/Contact.astro';
import { ACTION_COUNT, DEFAULT_LOG_STEP, FAQS, LOG } from '../data/console';

const title = 'A whole product team, running as software';
const description =
  'Ten specialist agents — product, design, copy, SEO, frontend, backend, QA, data, deploy — run one pipeline on your Shopify store, behind a human gate.';
const footerTicker = `last action · ${LOG[Math.min(LOG.length - 1, DEFAULT_LOG_STEP)][0]} · --:--`;
const origin = (Astro.site ?? new URL('https://agentify.plus')).origin;

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Console', item: `${origin}/` }],
  },
  {
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  title={title}
  description={description}
  path="/"
  ogImage="/og/console.png"
  ogImageAlt="The Agentify console: a pipeline of ten specialist agents shipping Shopify store changes behind a human gate"
  jsonLd={jsonLd}
  headerClock
  headerActions={ACTION_COUNT}
  footerVariant="console"
  footerTicker={footerTicker}
>
  <div class="progress" data-progress aria-hidden="true"></div>

  <Hero />
  <ConsoleSection />
  <Band />
  <Team />
  <Delta />
  <Access />
  <Faqs />
  <Contact />
</Base>

<script src="../scripts/console.ts"></script>

<style>
  .progress {
    position: fixed; top: 0; left: 0; z-index: 61;
    width: var(--progress, 0%); height: 3px; background: var(--mag);
    pointer-events: none;
  }
</style>
